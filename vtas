  if(charts[id]) charts[id].destroy();
  charts[id]=new Chart(document.getElementById(id),{
    type, data,
    options:{
      responsive:true, maintainAspectRatio:false,
      plugins:{
        legend:{display:type!=='bar'&&type!=='scatter'&&type!=='line',position:'right',labels:{boxWidth:12,font:{size:10}}},
        tooltip:{callbacks:{label:tipFn}}
      },
      scales: (type==='bar'||type==='line')?{
        y:{ticks:{callback:v=>fmt(v)}}
      }: scatter?{
        x:{title:{display:true,text:'Unidades'}},
        y:{title:{display:true,text:'Pesos'},ticks:{callback:v=>fmt(v)}}
      }:{}
    }
  });
}

