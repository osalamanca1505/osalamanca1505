<script>
/* ============================================================
   CONFIGURACIÓN: nombres flexibles de columnas.
   El script intenta detectar automáticamente las columnas.
   Ajusta las palabras clave si tu archivo usa otros nombres.
============================================================ */
const COL_KEYS = {
  region:   ['region','regional','zona','departamento','ciudad'],
  linea:    ['linea','línea','categoria','categoría','producto','marca','hdmo','pcmo','segmento'],
  cat2:     ['subcategoria','subcategoría','familia','tipo','grupo'],
  pesos:    ['pesos','venta','ventas','valor','importe','$'],
  unidades: ['unidades','cantidad','cant','qty','und'],
  medida:   ['medida','litros','galones','volumen','kg']
};

let RAW = [];        // datos completos
let HEADERS = [];    // encabezados
let colMap = {};     // mapeo detectado
let filtered = [];   // datos filtrados
let charts = {};     // instancias Chart.js
let currentPage = 1; const PAGE_SIZE = 50;

/* --- Utilidades --- */
const fmt = n => new Intl.NumberFormat('es-CO').format(Math.round(n||0));
const fmtMoney = n => '$'+fmt(n);
const palette = ['#0b5394','#e69138','#27ae60','#e74c3c','#8e44ad','#16a085','#f39c12','#2980b9','#c0392b','#7f8c8d','#d35400','#2ecc71'];

function detectColumns(){
  colMap = {};
  const lower = HEADERS.map(h => String(h).toLowerCase().trim());
  for(const key in COL_KEYS){
    for(let i=0;i<lower.length;i++){
      if(COL_KEYS[key].some(kw => lower[i].includes(kw))){
        if(!Object.values(colMap).includes(HEADERS[i])){ colMap[key]=HEADERS[i]; break; }
      }
    }
  }
  // Fallbacks
  if(!colMap.region) colMap.region = HEADERS<a href="" class="citation-link" target="_blank" style="vertical-align: super; font-size: 0.8em; margin-left: 3px;">[0]</a>;
  if(!colMap.linea)  colMap.linea  = HEADERS<a href="" class="citation-link" target="_blank" style="vertical-align: super; font-size: 0.8em; margin-left: 3px;">[1]</a> || HEADERS<a href="" class="citation-link" target="_blank" style="vertical-align: super; font-size: 0.8em; margin-left: 3px;">[0]</a>;
}

/* --- Lectura del archivo --- */
document.getElementById('fileInput').addEventListener('change', e=>{
  const file = e.target.files<a href="" class="citation-link" target="_blank" style="vertical-align: super; font-size: 0.8em; margin-left: 3px;">[0]</a>;
  if(!file) return;
  const reader = new FileReader();
  reader.onload = ev=>{
    const wb = XLSX.read(new Uint8Array(ev.target.result), {type:'array'});
    const ws = wb.Sheets[wb.SheetNames<a href="" class="citation-link" target="_blank" style="vertical-align: super; font-size: 0.8em; margin-left: 3px;">[0]</a>];
    const json = XLSX.utils.sheet_to_json(ws, {header:1, defval:''});
    HEADERS = json<a href="" class="citation-link" target="_blank" style="vertical-align: super; font-size: 0.8em; margin-left: 3px;">[0]</a>.map(h=>String(h).trim());
    RAW = json.slice(1).filter(r=>r.some(c=>c!=='')).map(r=>{
      const obj={}; HEADERS.forEach((h,i)=>obj[h]=r[i]); return obj;
    });
    detectColumns();
    populateFilters();
    document.getElementById('emptyMsg').style.display='none';
    applyFilters();
  };
  reader.readAsArrayBuffer(file);
});

/* --- Poblar segmentadores --- */
function uniqueVals(col){
  return [...new Set(RAW.map(r=>r[col]).filter(v=>v!==''&&v!=null))].sort();
}
function populateFilters(){
  fillSelect('fRegion', colMap.region);
  fillSelect('fLinea', colMap.linea);
  fillSelect('fCat2', colMap.cat2);
}
function fillSelect(id, col){
  const sel=document.getElementById(id);
  sel.innerHTML='<option value="">Todas</option>';
  if(!col){ sel.disabled=true; return;} sel.disabled=false;
  uniqueVals(col).forEach(v=>{
    const o=document.createElement('option'); o.value=v; o.textContent=v; sel.appendChild(o);
  });
}
['fRegion','fLinea','fCat2','fMetric'].forEach(id=>
  document.getElementById(id).addEventListener('change', applyFilters));
document.getElementById('tableSearch').addEventListener('input', ()=>{currentPage=1;renderTable();});

function resetFilters(){
  ['fRegion','fLinea','fCat2'].forEach(id=>document.getElementById(id).value='');
  document.getElementById('tableSearch').value='';
  applyFilters();
}

/* --- Aplicar filtros --- */
function getNum(v){ const n=parseFloat(String(v).replace(/[^0-9.-]/g,'')); return isNaN(n)?0:n; }
function metricCol(){
  const m=document.getElementById('fMetric').value;
  return colMap[m] || colMap.pesos || colMap.unidades;
}
function applyFilters(){
  const reg=document.getElementById('fRegion').value;
  const lin=document.getElementById('fLinea').value;
  const c2=document.getElementById('fCat2').value;
  filtered = RAW.filter(r=>
    (!reg || r[colMap.region]==reg) &&
    (!lin || r[colMap.linea]==lin) &&
    (!c2  || !colMap.cat2 || r[colMap.cat2]==c2)
  );
  currentPage=1;
  updateKPIs(); renderCharts(); renderTable();
}

/* --- KPIs --- */
function updateKPIs(){
  const pesosCol=colMap.pesos, unidCol=colMap.unidades;
  const tp = pesosCol ? filtered.reduce((s,r)=>s+getNum(r[pesosCol]),0) : 0;
  const tu = unidCol ? filtered.reduce((s,r)=>s+getNum(r[unidCol]),0) : 0;
  document.getElementById('kpiPesos').textContent = pesosCol?fmtMoney(tp):'N/D';
  document.getElementById('kpiUnid').textContent  = unidCol?fmt(tu):'N/D';
  document.getElementById('kpiRows').textContent  = fmt(filtered.length);
  document.getElementById('kpiReg').textContent   = new Set(filtered.map(r=>r[colMap.region])).size;
}

/* --- Agregación --- */
function groupSum(col, valCol){
  const map={};
  filtered.forEach(r=>{ const k=r[col]||'(vacío)'; map[k]=(map[k]||0)+getNum(r[valCol]); });
  return Object.entries(map).sort((a,b)=>b<a href="" class="citation-link" target="_blank" style="vertical-align: super; font-size: 0.8em; margin-left: 3px;">[1]</a>-a<a href="" class="citation-link" target="_blank" style="vertical-align: super; font-size: 0.8em; margin-left: 3px;">[1]</a>);
}

/* --- Render de gráficos --- */
function renderCharts(){
  const val=metricCol();
  const isMoney = document.getElementById('fMetric').value==='pesos';
  const tip = ctx => (isMoney?'$':'')+fmt(ctx.parsed.y ?? ctx.parsed);

  // BARRAS por región
  const byReg = groupSum(colMap.region, val).slice(0,12);
  makeChart('chartBar','bar',{
    labels:byReg.map(d=>d<a href="" class="citation-link" target="_blank" style="vertical-align: super; font-size: 0.8em; margin-left: 3px;">[0]</a>),
    datasets:[{label:'Total',data:byReg.map(d=>d<a href="" class="citation-link" target="_blank" style="vertical-align: super; font-size: 0.8em; margin-left: 3px;">[1]</a>),backgroundColor:palette<a href="" class="citation-link" target="_blank" style="vertical-align: super; font-size: 0.8em; margin-left: 3px;">[0]</a>}]
  }, tip);
  setInsight('insBar', byReg, isMoney, 'región');

  // TORTA por línea
  const byLin = groupSum(colMap.linea, val).slice(0,10);
  makeChart('chartPie','doughnut',{
    labels:byLin.map(d=>d<a href="" class="citation-link" target="_blank" style="vertical-align: super; font-size: 0.8em; margin-left: 3px;">[0]</a>),
    datasets:[{data:byLin.map(d=>d<a href="" class="citation-link" target="_blank" style="vertical-align: super; font-size: 0.8em; margin-left: 3px;">[1]</a>),backgroundColor:palette}]
  }, ctx=>`${ctx.label}: ${(isMoney?'$':'')+fmt(ctx.parsed)}`);
  setInsight('insPie', byLin, isMoney, 'línea/categoría');

  // ÁREAS por línea
  makeChart('chartArea','line',{
    labels:byLin.map(d=>d<a href="" class="citation-link" target="_blank" style="vertical-align: super; font-size: 0.8em; margin-left: 3px;">[0]</a>),
    datasets:[{label:'Total',data:byLin.map(d=>d<a href="" class="citation-link" target="_blank" style="vertical-align: super; font-size: 0.8em; margin-left: 3px;">[1]</a>),fill:true,
      backgroundColor:'rgba(11,83,148,.2)',borderColor:palette<a href="" class="citation-link" target="_blank" style="vertical-align: super; font-size: 0.8em; margin-left: 3px;">[0]</a>,tension:.3}]
  }, tip);
  document.getElementById('insArea').textContent =
    `Distribución de la métrica entre las líneas. La línea líder es "${byLin<a href="" class="citation-link" target="_blank" style="vertical-align: super; font-size: 0.8em; margin-left: 3px;">[0]</a>?.<a href="" class="citation-link" target="_blank" style="vertical-align: super; font-size: 0.8em; margin-left: 3px;">[0]</a>||'—'}".`;

  // DISPERSIÓN unidades vs pesos
  if(colMap.unidades && colMap.pesos){
    const pts = filtered.slice(0,3000).map(r=>({x:getNum(r[colMap.unidades]),y:getNum(r[colMap.pesos])}));
    makeChart('chartScatter','scatter',{
      datasets:[{label:'Registros',data:pts,backgroundColor:'rgba(230,145,56,.5)'}]
    }, ctx=>`Und: ${fmt(ctx.parsed.x)} | $${fmt(ctx.parsed.y)}`, true);
    document.getElementById('insScatter').textContent =
      'Cada punto es un registro. Muestra la relación entre unidades vendidas y valor en pesos.';
  }
}

